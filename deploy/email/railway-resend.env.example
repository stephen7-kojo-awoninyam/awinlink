# TEMPLATE ONLY. No production variables were changed.
# Resend HTTPS API works without outbound SMTP on Railway Free.
DEBUG=False
EMAIL_PROVIDER=resend
# A Resend sending-access key scoped to your verified domain. Keep secret.
RESEND_API_KEY=
RESEND_TIMEOUT=10
# Replace placeholders with your provider-verified sender/domain and real origin.
DEFAULT_FROM_EMAIL=Awinlink <recovery@your-verified-domain.example>
EMAIL_SENDER_DOMAIN=your-verified-domain.example
PASSWORD_RESET_BASE_URL=https://your-canonical-web-domain.example
PASSWORD_RESET_TIMEOUT=3600
REDIS_URL=${{Redis.REDIS_URL}}
# EMAIL_HOST/PORT/SMTP credentials and TLS flags are not used by Resend delivery.
