# TEMPLATE ONLY: not applied to Railway. Replace all blank and example fields.
# Postmark transactional SMTP (not its broadcast endpoint).
DEBUG=False
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Stream-scoped SMTP Access Key and Secret Key from the transactional stream.
# Enter secrets directly in Railway's backend service variables; never in Expo.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Replace with the exact provider-approved sender and its domain.
DEFAULT_FROM_EMAIL=Awinlink <no-reply@your-verified-domain.example>
EMAIL_SENDER_DOMAIN=your-verified-domain.example
PASSWORD_RESET_BASE_URL=https://your-canonical-web-domain.example
PASSWORD_RESET_TIMEOUT=3600
# Keep the existing shared Redis service reference for recovery rate limiting.
REDIS_URL=${{Redis.REDIS_URL}}
