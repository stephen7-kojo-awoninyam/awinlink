# Awinlink Django service on Railway; public relay is hosted separately.
# Replace the example hostname. Keep production and staging secrets distinct.
TURN_SERVER_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# Set privately as a sealed Railway variable. Never commit a real value.
TURN_SHARED_SECRET=
TURN_REQUIRED=true
TURN_CREDENTIAL_TTL_SECONDS=3600
# Use relay only in staging to prove TURN connectivity; normal production: all.
CALL_ICE_TRANSPORT_POLICY=all
