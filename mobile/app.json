{
  "expo": {
    "name": "Awinlink",
    "slug": "awinlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/awinlink-icon.png",
    "scheme": "awinlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.awinlink.app",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.awinlink.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2458d3",
        "foregroundImage": "./assets/images/awinlink-foreground.png",
        "monochromeImage": "./assets/images/awinlink-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/awinlink-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withClassroomScreenShare.cjs",
      "./plugins/withNativeCalls.cjs",
      "expo-document-picker",
      "expo-notifications",
      ["expo-audio", {"microphonePermission": "Allow Awinlink to record voice messages.", "enableBackgroundPlayback": false, "enableBackgroundRecording": false}],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Awinlink to use your camera during video calls.",
          "microphonePermission": "Allow Awinlink to use your microphone during calls."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/awinlink-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
