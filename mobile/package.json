{
  "name": "mobile",
  "main": "index.js",
  "version": "1.0.0",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/ui": "^57.0.25",
    "decode-uri-component": "file:vendor/decode-uri-component-cjs",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-callkeep": "4.3.16",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-voip-push-notification": "3.3.3",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "25.1.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check:release": "node scripts/check-release.cjs",
    "check:urls": "node scripts/check-production-urls.cjs",
    "eas:whoami": "eas whoami",
    "build:android": "eas build --platform android --profile production --freeze-credentials",
    "build:android:apk": "eas build --platform android --profile android-apk --freeze-credentials",
    "build:ios": "eas build --platform ios --profile production --freeze-credentials",
    "build:device": "eas build --platform all --profile preview-device",
    "export:android": "expo export --platform android --max-workers 2",
    "export:ios": "expo export --platform ios --max-workers 2",
    "test:media": "node --test tests/media.test.cjs tests/media-browser.test.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:classroom-client": "node scripts/build-classroom-client.cjs",
    "test:classroom": "node --test tests/classroom-client.test.cjs tests/classroom-browser.test.cjs tests/classroom-management-browser.test.cjs"
  },
  "private": true,
  "overrides": {
    "eas-cli": {
      "joi": "17.13.8",
      "ajv": "8.18.0",
      "minimatch@5.1.2": "5.1.9",
      "@oclif/core@4.14.0": { "minimatch": "10.2.6" },
      "glob@13.0.6": { "minimatch": "10.2.6" },
      "nanoid": "3.3.20",
      "tar": "7.5.22",
      "yaml": "2.8.3"
    },
    "@expo/eas-json": {
      "joi": "17.13.8"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "$decode-uri-component"
  }
}
