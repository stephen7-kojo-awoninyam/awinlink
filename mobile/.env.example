# Use the API origin only; the app appends /api/ to API requests.
# For a physical device, use the computer's LAN address (e.g. http://192.168.1.20:8000).
# For production, use the HTTPS origin of the deployed Django service.
EXPO_PUBLIC_API_URL=https://awinlink-production.up.railway.app
EXPO_PUBLIC_EAS_PROJECT_ID=
AWINLINK_ANDROID_PACKAGE=com.awinlink.app
AWINLINK_IOS_BUNDLE_IDENTIFIER=com.awinlink.app
AWINLINK_APPLE_TEAM_ID=
# Path supplied by the local build environment or an EAS file variable. Never commit credentials.
AWINLINK_GOOGLE_SERVICES_FILE=
# These routes are implemented locally. Deploy the backend pages and verify HTTP 200
# before using these values in a signed build. Operator/contact review is required.
EXPO_PUBLIC_PRIVACY_URL=https://awinlink-production.up.railway.app/privacy/
EXPO_PUBLIC_TERMS_URL=https://awinlink-production.up.railway.app/terms/
EXPO_PUBLIC_SUPPORT_URL=https://awinlink-production.up.railway.app/support/
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://awinlink-production.up.railway.app/delete-account/

# Optional authenticated Django TURN configuration: set TURN_SERVER_URLS and TURN_SHARED_SECRET
# on the server (and configure coturn's use-auth-secret with the same secret). The API issues
# temporary credentials; do not place TURN shared secrets in EXPO_PUBLIC_* app variables.

# Optional link for account registration and existing web-only onboarding.
EXPO_PUBLIC_WEB_URL=https://awinlink-production.up.railway.app
