# Use the API origin only; the app appends /api/ to API requests.
# For a physical device, use the computer's LAN address (e.g. http://192.168.1.20:8000).
# For production, use the HTTPS origin of the deployed Django service.
EXPO_PUBLIC_API_URL=https://awinlink-production.up.railway.app
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional authenticated Django TURN configuration: set TURN_SERVER_URLS and TURN_SHARED_SECRET
# on the server (and configure coturn's use-auth-secret with the same secret). The API issues
# temporary credentials; do not place TURN shared secrets in EXPO_PUBLIC_* app variables.

# Optional link for account registration and existing web-only onboarding.
EXPO_PUBLIC_WEB_URL=https://awinlink-production.up.railway.app
